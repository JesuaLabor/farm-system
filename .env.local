# Firebase Configuration — Local Emulator (Development)
# These values work with the Firebase Emulator Suite (no real project needed)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-farm-system-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-no-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-no-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-no-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Tells the app to connect to local emulators instead of production Firebase
NEXT_PUBLIC_USE_EMULATORS=true

# Cloudinary Configuration (Optional for images — leave as-is for development)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
